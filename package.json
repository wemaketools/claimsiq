{
  "name": "claimsiq",
  "version": "0.1.0",
  "private": true,
  "description": "ClaimsIQ (Claims Intelligence): claims control tower for insurers. Stage A: SPA with typed contracts, a rules engine and a mock API over versioned fixtures. Stage B: Postgres schema with per-tenant row level security, seeded from the same fixtures.",
  "type": "module",
  "workspaces": [
    "src/ui",
    "e2e_tests"
  ],
  "scripts": {
    "supabase:start": "bun scripts/db/ensure-signing-keys.mjs && supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "auth:personas": "bun scripts/dev/seed-auth-personas.ts",
    "db:migrate": "supabase migration up --local",
    "db:reset": "bun scripts/db/reset.ts",
    "db:seed": "bun scripts/db/seed.ts",
    "db:types": "bun scripts/db/generate-types.ts",
    "dev": "bun scripts/dev/dev-all.ts",
    "dev:api": "bun scripts/dev/serve-api.ts",
    "dev:ui": "bun run --filter @claimsiq/ui dev",
    "dev:prototype": "bun run --filter @claimsiq/ui dev:prototype",
    "typecheck": "tsc -p tsconfig.server.json",
    "typecheck:ui": "bun run --filter @claimsiq/ui typecheck",
    "lint": "eslint --no-error-on-unmatched-pattern api src/server src/contracts src/mock-api src/read-model src/rules scripts",
    "lint:ui": "bun run --filter @claimsiq/ui lint",
    "format:ui": "bun run --filter @claimsiq/ui format",
    "build:ui": "bun run --filter @claimsiq/ui build",
    "build": "bun run typecheck && bun run build:ui",
    "build:prototype": "VITE_AUTH_MODE=prototype bun run build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:ui": "bun run --filter @claimsiq/ui test",
    "ci:security": "bun scripts/ci/scan-secrets.ts && bun scripts/ci/scan-bundle.ts && bun scripts/ci/scan-bundle.ts --prototype",
    "ci:test:ui": "bun run --filter @claimsiq/ui test --reporter=default --reporter=json --outputFile.json=../../.test-results/vitest-ui.json && bun scripts/ci/assert-test-run.ts --report .test-results/vitest-ui.json --min-tests 59",
    "ci:test:unit": "vitest run --project unit --reporter=default --reporter=json --outputFile.json=.test-results/vitest-unit.json && bun scripts/ci/assert-test-run.ts --report .test-results/vitest-unit.json --min-tests 34",
    "test:e2e": "bun run --filter @claimsiq/e2e test",
    "test:e2e:prototype": "E2E_PROJECT=prototype bun run --filter @claimsiq/e2e test",
    "verify": "bun run typecheck && bun run typecheck:ui && bun run lint && bun run lint:ui && bun run test && bun run test:ui && bun run build:ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "decimal.js": "^10.6.0",
    "hono": "^4.13.11",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "supabase": "2.118.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "supabase"
  ]
}
