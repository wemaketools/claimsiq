# ClaimsIQ: LOCAL environment catalog. Copy to .env.local (git-ignored).
#
# Values come from `bunx supabase status -o env` for the local Docker stack (`bun run supabase:start`);
# .\run.ps1 writes them for you. Placeholders only in this file: no key, token or password is ever committed.
# `bun run auth:personas` provisions the demo accounts. The backend adds its variables to the config schema and
# here in the same change.

APP_ENV=local
LOG_LEVEL=info

# Local Supabase API (Auth). The JWT issuer is http://127.0.0.1:54421/auth/v1.
SUPABASE_URL=http://127.0.0.1:54421
# ANON_KEY from `bunx supabase status -o env`.
SUPABASE_ANON_KEY=<local-anon-key>
# SERVICE_ROLE_KEY from `bunx supabase status -o env`. Server only (auth:personas uses it).
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>

# Browser-safe values for the SPA (Vite reads this root file).
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=<local-anon-key>
