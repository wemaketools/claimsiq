# ClaimsIQ: LOCAL environment catalog. Copy to .env.local (git-ignored).
#
# Values come from `bunx supabase status -o env` for the local Docker stack (`bun run supabase:start`);
# .\run.ps1 writes them for you. Placeholders only in this file: no key, token or password is ever committed.
# `bun run auth:personas` provisions the demo accounts and `bun run db:reset` builds the database. The backend adds
# its variables to the config schema and here in the same change.

# Port of the local API server (bun run dev:api); optional, default 5274. The Vite dev server proxies /api to it.
API_PORT=5274
APP_ENV=local
LOG_LEVEL=info

# Optional: the password of the demo accounts. Blank, the local stack uses its committed demo password (APP_ENV=local only).
DEMO_SEED_PASSWORD=

# Local Postgres of the Supabase stack (DB_URL from `bunx supabase status -o env`): the db scripts, the seed and the
# database tests connect here. The password is the stack's own local one; never commit the real line.
DATABASE_URL=postgresql://postgres:<local-db-password>@127.0.0.1:54422/postgres

# Local Supabase API (Auth). The JWT issuer is http://127.0.0.1:54421/auth/v1.
SUPABASE_URL=http://127.0.0.1:54421
# ANON_KEY from `bunx supabase status -o env`.
SUPABASE_ANON_KEY=<local-anon-key>
# SERVICE_ROLE_KEY from `bunx supabase status -o env`. Server only (auth:personas uses it).
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>

# Browser-safe values for the SPA (Vite reads this root file).
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=<local-anon-key>
