# ClaimsIQ: DEPLOYED environment catalog. Placeholders only; never real values.
#
# The source of truth for deployed values is the secret store synced to Vercel and GitHub environments. Keys are
# alphabetical, KEY="value", to match an export of it.
# Only src/server/lib/config reads these (lint-enforced). Blank values count as unset.
# The backend adds its variables (job secrets, storage, email) to the config schema and to this
# file in the same change.

# Port of the local API server (bun run dev:api); a deployed function ignores it. Optional, default 5274.
API_PORT="5274"

# Runtime environment: local | dev | preview | staging | production. Set it explicitly when deployed; the only
# behavioural branch is "not local" (HSTS, https-only SUPABASE_URL).
APP_ENV="production"

# Postgres connection URL (direct connection, not a transaction pooler): the database scripts and the API connect
# with it. Optional until the API (Stage B) is deployed.
DATABASE_URL="postgresql://postgres:<database-password>@<host>:5432/postgres"

# The password of the demo accounts in this environment (the demo seed gives it to them; the demo sign-in endpoint signs
# a clicked role in with it). SERVER ONLY, set per environment in the secret store, never in the repository. When unset
# outside APP_ENV=local, a click on a demo role only fills the e-mail into the sign-in form.
DEMO_SEED_PASSWORD="<demo-account-password>"

# Log verbosity: debug | info | warn | error (optional, default info). Logs never contain tokens, keys or e-mails.
LOG_LEVEL="info"

# Supabase anon (publishable) key. Server side it is used ONLY by the token-verification client (getClaims).
SUPABASE_ANON_KEY="<supabase-anon-key>"

# Supabase service-role key: Auth Admin API (user provisioning) and, from Stage B, Storage.
# SERVER ONLY. Mark it Sensitive in Vercel. It must never reach the SPA bundle (scan-bundle fails on it).
SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-key>"

# Project URL (https outside local). The JWT issuer is pinned to <SUPABASE_URL>/auth/v1 and the signing keys are
# read from <SUPABASE_URL>/auth/v1/.well-known/jwks.json. SUPABASE_JWT_SECRET is intentionally absent (ES256 keys).
SUPABASE_URL="https://<project-ref>.supabase.co"

# Browser-safe values compiled into the SPA by Vite. Nothing else may carry the VITE_ prefix.
VITE_SUPABASE_ANON_KEY="<supabase-anon-key>"
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
